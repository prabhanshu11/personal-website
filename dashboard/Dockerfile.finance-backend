FROM python:3.12-slim

# Install UV and curl for healthcheck
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy dependency files
COPY finance/backend/pyproject.toml finance/backend/uv.lock ./

# Install dependencies
RUN uv sync --frozen --no-install-project

# Copy source code
COPY finance/backend/src ./src

# Install the project
RUN uv sync --frozen

# Create data directory (SQLite + Gmail token storage)
RUN mkdir -p /app/data

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH="/app/src"

EXPOSE 8083

CMD ["uv", "run", "uvicorn", "finance_api.app:app", "--host", "0.0.0.0", "--port", "8083"]
