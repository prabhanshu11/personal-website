FROM python:3.12-slim

# Install UV and curl for healthcheck
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy dependency files
COPY habit-tracker/backend/pyproject.toml habit-tracker/backend/uv.lock ./

# Install dependencies
RUN uv sync --frozen --no-install-project

# Copy source code
COPY habit-tracker/backend/src ./src

# Install the project
RUN uv sync --frozen

# Create data directory
RUN mkdir -p /app/data

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH="/app/src"

EXPOSE 8081

CMD ["uv", "run", "uvicorn", "habits_api.app:app", "--host", "0.0.0.0", "--port", "8081"]
